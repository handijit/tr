{
  "extends": "@handijitcom/config/tsconfig/library.json",
  "compilerOptions": {
    // Node 24 (the engines floor) and every evergreen browser since 2022 run ES2022 natively;
    // nothing to downlevel.
    "target": "ES2022",
    // No DOM: the package uses only the language and Intl, so a browser-only API is a type error.
    "lib": ["ES2022"]
  }
}
